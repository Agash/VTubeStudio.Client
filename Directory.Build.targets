<Project>

  <!-- These settings are intentionally in Directory.Build.targets, not .props: $(IsPackable)
       is assigned inside each csproj body, which is evaluated AFTER Directory.Build.props but
       BEFORE Directory.Build.targets. Keying them off $(IsPackable) in .props silently no-ops
       (the value is empty there), which previously left XML docs disabled on the published
       packages and CS1591 unenforced. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Treat missing XML docs (CS1591) as errors on packable projects so the published surface is fully documented. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- Every packable project ships the repo README, so each csproj doesn't repeat itself. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
