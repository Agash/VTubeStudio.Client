<Project>
  <!-- The runtime's own packages follow the target: each framework takes the release band it
       ships with, so a net11.0 consumer gets the .NET 11 libraries and older targets stay on 10.
       Directory.Packages.props names this version. It is set here, after the project body, because a
       project with a single TargetFramework has not set it yet when the props are imported; items,
       PackageVersion among them, are evaluated after every property, so they see this value. -->
  <PropertyGroup>
    <DotNetPackageVersion>10.0.14</DotNetPackageVersion>
    <DotNetPackageVersion
      Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))"
      >11.0.0-rc.3.26522.148</DotNetPackageVersion>
  </PropertyGroup>
  <!-- These settings are intentionally in Directory.Build.targets, not .props: $(IsPackable)
       is assigned inside each csproj body, which is evaluated AFTER Directory.Build.props but
       BEFORE Directory.Build.targets. Keying them off $(IsPackable) in .props silently no-ops
       (the value is empty there), which previously left XML docs disabled on the published
       packages and CS1591 unenforced. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Treat missing XML docs (CS1591) as errors on packable projects so the published surface is fully documented. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- Every packable project ships the repo README, so each csproj doesn't repeat itself. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="\"
      Visible="false"
    />
  </ItemGroup>
</Project>
