<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>VTubeStudio.Client</PackageId>
    <Title>VTubeStudio.Client</Title>
    <Description>Modern .NET 10 / C# 14 client library for the VTube Studio WebSocket API. AOT-friendly, System.Text.Json source-generated, fully typed.</Description>
    <PackageTags>vtubestudio;vtuber;live2d;client;websocket;stj</PackageTags>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- IDE0005 (remove unnecessary usings) only runs with GenerateDocumentationFile=true, which this
         package does not enable; suppress so the build doesn't demand doc generation. -->
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
  </ItemGroup>

</Project>
