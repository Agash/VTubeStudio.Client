<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>VTubeStudio.Client</PackageId>
    <Title>VTubeStudio.Client</Title>
    <Description>Modern .NET 10 / C# 14 client library for the VTube Studio WebSocket API. AOT-friendly, System.Text.Json source-generated, fully typed.</Description>
    <PackageTags>vtubestudio;vtuber;live2d;client;websocket;stj</PackageTags>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Generate XML docs so the published package ships IntelliSense. Set here (csproj .props phase)
         rather than in Directory.Build.targets: the SDK reads GenerateDocumentationFile to compute
         DocumentationFile and the csc /doc switch before Directory.Build.targets is imported, so
         setting it there is too late and silently produces no docs / no CS1591 enforcement. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
  </ItemGroup>

</Project>
