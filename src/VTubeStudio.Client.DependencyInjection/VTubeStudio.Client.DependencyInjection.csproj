<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>VTubeStudio.Client.DependencyInjection</PackageId>
    <Title>VTubeStudio.Client.DependencyInjection</Title>
    <Description>DI extensions for VTubeStudio.Client. Registers the client and its options in Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>vtubestudio;client;di;ioc</PackageTags>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Generate XML docs so the published package ships IntelliSense. Set here (csproj .props phase)
         rather than in Directory.Build.targets: the SDK reads GenerateDocumentationFile to compute
         DocumentationFile and the csc /doc switch before Directory.Build.targets is imported, so
         setting it there is too late and silently produces no docs / no CS1591 enforcement. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VTubeStudio.Client\VTubeStudio.Client.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
  </ItemGroup>

</Project>
