<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>VTubeStudio.Client.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Verify the lib is genuinely native-AOT and trim-safe by publishing the sample with both enabled. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sample app: not shipped; don't gate the build on code-style analyzers. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VTubeStudio.Client\VTubeStudio.Client.csproj" />
    <ProjectReference Include="..\..\src\VTubeStudio.Client.DependencyInjection\VTubeStudio.Client.DependencyInjection.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
</Project>
